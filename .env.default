# .env.default
#
# Machine-wide default settings for the local RAG system, shared by every
# data store. This file is committed; src/config.py fails with a clear error
# if one of these is missing.
#
# Per-store settings (models, chunking, retrieval, paths) don't go here. They
# live in stores/<name>/store.toml, with defaults in stores/defaults.toml.
#
# Don't edit this file to change your local setup. Put overrides in .env
# instead (see .env.example). Precedence, highest first:
#   1. Variables already set in your shell
#   2. .env
#   3. .env.default

# --- Ollama -----------------------------------------------------------------

# Address of the Ollama server used for both embeddings and chat.
OLLAMA_HOST=http://localhost:11434

# --- Data store -------------------------------------------------------------

# Store to use when a command isn't given --store: the name of a folder under
# stores/ that has a store.toml. Change it in .env, or for one run:
#   python -m src.app --store research
RAG_STORE=default
