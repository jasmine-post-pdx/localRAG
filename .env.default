# .env.default
#
# Default settings for the local RAG system. This file is committed and is
# the single source of truth for every setting the app reads; src/config.py
# fails with a clear error if one of these is missing.
#
# Don't edit this file to change your local setup. Put overrides in .env
# instead (see .env.example). Precedence, highest first:
#   1. Variables already set in your shell
#   2. .env
#   3. .env.default

# --- Ollama -----------------------------------------------------------------

# Address of the Ollama server used for both embeddings and chat.
OLLAMA_HOST=http://localhost:11434

# --- Models -----------------------------------------------------------------

# Ollama model that embeds document chunks and questions. Pull it first with
# `ollama pull <name>`. Changing it requires rebuilding the vector store,
# because vectors from different models can't be compared.
EMBEDDING_MODEL=nomic-embed-text

# Ollama chat model that writes the answers. Pull it first with
# `ollama pull <name>`. Safe to change without re-ingesting.
LLM_MODEL=qwen3:8b

# Sampling temperature. 0 gives the same answer for the same question and
# context; higher values give more varied wording.
LLM_TEMPERATURE=0

# Context window in tokens, passed to Ollama as num_ctx. It must hold the
# prompt, the retrieved chunks, and the answer. Larger values use more memory.
LLM_CONTEXT_WINDOW=8192

# --- Paths ------------------------------------------------------------------
# Relative paths are resolved from the directory you run the app in, which
# should be the project root (`python -m src.ingest`, `python -m src.app`).

# Folder searched recursively for .pdf, .txt, and .md files to ingest.
DOCUMENTS_PATH=data/documents

# Folder where Chroma saves the vector store.
VECTORSTORE_PATH=data/vectorstore

# --- Ingestion --------------------------------------------------------------
# Chunk IDs are <source>:<page>:<chunk_index>, so changing the chunk settings
# makes new chunks reuse old IDs. Delete the vector store contents and ingest
# again after changing either value.

# Maximum characters per chunk.
CHUNK_SIZE=1000

# Characters shared between consecutive chunks so context isn't cut off at
# chunk boundaries. Must be smaller than CHUNK_SIZE.
CHUNK_OVERLAP=200

# Number of chunks sent to Ollama per embedding request. Lower it if Ollama
# errors or runs out of memory during ingestion.
EMBEDDING_BATCH_SIZE=32

# --- Retrieval --------------------------------------------------------------

# Number of most similar chunks added to the prompt for each question.
RETRIEVAL_K=3
